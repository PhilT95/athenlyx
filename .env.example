# Copy to .env next to compose.yaml. Never commit the real .env.

# Local port the host nginx proxies to (bound to 127.0.0.1 only).
APP_PORT=6559

# Image tag used for the built images (the updater sets this to the commit SHA).
IMAGE_TAG=local

# ---- Updater ---------------------------------------------------------------
# Local port the host nginx proxies /hooks/ to (bound to 127.0.0.1 only).
UPDATER_PORT=6560

# Git repository the updater builds from. Only this URL is ever fetched.
REPO_URL=https://github.com/PhilT95/athenlyx.git

# Branch that gets deployed.
ALLOWED_REF=refs/heads/main

# Shared secret for the HMAC signature (min. 32 chars). Must match the
# UPDATE_SECRET secret in GitHub. Generate with: openssl rand -hex 32
UPDATE_SECRET=

# Number of old image versions kept for rollback.
KEEP_IMAGES=3

# Place this file at: /etc/systemd/system/webhook.service
# Then run:
#   systemctl daemon-reload
#   systemctl enable --now webhook

[Unit]
Description=Webhook Deploy Listener
After=network.target

[Service]
Type=simple
User=linuxadmin
ExecStart=/usr/bin/webhook -hooks /etc/webhook/hooks.yaml -port 9000 -verbose
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target

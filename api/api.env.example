# Copy this file to /etc/athenlyx/api.env on the server.
# Set permissions: chmod 640 /etc/athenlyx/api.env
#                  chown root:linuxadmin /etc/athenlyx/api.env
#
# The actual api.env must NOT be committed to the repository.

# A strong random token used to authenticate the deploy webhook.
# Must match the DEPLOY_TOKEN secret set in GitHub Actions.
# Generate with: openssl rand -hex 32
DEPLOY_TOKEN=REPLACE_WITH_YOUR_SECRET_TOKEN

# Absolute path to the built static site directory (where search_index.json lives).
SITE_DIR=/www

# Absolute path to the sync script that pulls from Git and rebuilds the site.
SYNC_SCRIPT=/usr/athenlyx/scripts/sync.sh

# Replaces deploy/webhook.service — this runs the unified FastAPI app instead
# of the standalone webhook tool.
#
# Place this file at: /etc/systemd/system/athenlyx-api.service
# Place api.env at:   /etc/athenlyx/api.env  (chmod 640, chown root:linuxadmin)
#
# Then run:
#   systemctl daemon-reload
#   systemctl enable --now athenlyx-api

[Unit]
Description=AthenlyX API (deploy webhook + content API)
After=network.target

[Service]
Type=simple
User=linuxadmin

# Environment variables — keep this file root-readable only.
EnvironmentFile=/etc/athenlyx/api.env

# Run uvicorn from the directory containing main.py.
WorkingDirectory=/usr/athenlyx/api
ExecStart=/home/linuxadmin/.local/bin/uvicorn main:app --host 127.0.0.1 --port 8000

Restart=on-failure
RestartSec=5s

# Basic hardening
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
